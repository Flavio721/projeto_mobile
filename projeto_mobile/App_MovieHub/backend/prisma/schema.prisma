generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovieStatus {
  WATCHLIST
  WATCHED
}

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  password  String
  avatarUrl String?
  movies    UserMovie[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Metadata is fetched from TMDB and cached only when a user adds a movie.
model Movie {
  id          Int         @id @default(autoincrement())
  tmdbId      Int         @unique
  title       String
  posterPath  String?
  releaseDate String?
  overview    String      @default("")
  runtime     Int?
  genres      String[]    @default([])
  voteAverage Float?
  entries     UserMovie[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// One personal entry per account and TMDB movie. Rewatching edits this entry.
model UserMovie {
  id         Int         @id @default(autoincrement())
  userId     String
  movieId    Int
  status     MovieStatus @default(WATCHLIST)
  isFavorite Boolean     @default(false)
  rating     Int?
  comment    String?
  watchedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie      Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, movieId])
  @@index([userId, status])
  @@index([userId, isFavorite])
}
