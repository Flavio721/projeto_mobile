generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovieStatus {
  WATCHLIST
  WATCHED
}

enum BookReadingStatus {
  WANT_TO_READ
  READING
  READ
  PAUSED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id        String      @id @default(cuid())
  name      String
  username  String      @unique
  email     String      @unique
  password  String?
  googleSub String?     @unique
  avatarUrl String?
  avatarPublicId String?
  shareWatched   Boolean @default(true)
  shareWatchlist Boolean @default(true)
  shareFavorites Boolean @default(true)
  shareReviews   Boolean @default(true)
  shareRecent    Boolean @default(true)
  shareBooks     Boolean @default(true)
  movies    UserMovie[]
  books     UserBook[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Metadata is fetched from TMDB and cached only when a user adds a movie.
model Movie {
  id          Int         @id @default(autoincrement())
  tmdbId      Int         @unique
  title       String
  posterPath  String?
  releaseDate String?
  overview    String      @default("")
  runtime     Int?
  genres      String[]    @default([])
  voteAverage Float?
  entries     UserMovie[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// One personal entry per account and TMDB movie. Rewatching edits this entry.
model UserMovie {
  id         Int         @id @default(autoincrement())
  userId     String
  movieId    Int
  status     MovieStatus @default(WATCHLIST)
  isFavorite Boolean     @default(false)
  rating     Int?
  comment    String?
  watchedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie      Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, movieId])
  @@index([userId, status])
  @@index([userId, isFavorite])
}

// Google Books metadata is stored separately from each user's reading state.
model Book {
  id            Int        @id @default(autoincrement())
  googleBooksId String     @unique
  title         String
  subtitle      String?
  isbn10        String?    @unique
  isbn13        String?    @unique
  authors       String[]   @default([])
  description   String     @default("")
  publisher     String?
  publishedDate String?
  pageCount     Int?
  coverUrl      String?
  language      String?
  categories    String[]   @default([])
  userBooks     UserBook[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model UserBook {
  id         Int              @id @default(autoincrement())
  userId     String
  bookId     Int
  status     BookReadingStatus @default(WANT_TO_READ)
  isFavorite Boolean          @default(false)
  rating     Int?
  comment    String?
  startedAt  DateTime?
  finishedAt DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([userId, isFavorite])
}
