{
  "expo": {
    "name": "App_MovieHub",
    "slug": "App_MovieHub",
    "scheme": "moviehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.flavio721.moviehub",
      "supportsTablet": true
    },
    "android": {
      "package": "com.flavio721.moviehub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O MovieHub usa sua localização apenas para encontrar cinemas próximos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O MovieHub acessa suas fotos para permitir a escolha de uma imagem de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "ceb3a960-0c87-4778-b20a-71e4c9fcc985"
      }
    }
  }
}
